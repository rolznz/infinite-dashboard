# Copy to .env and fill in. Never commit .env.

# --- Required for M1 ---
# LLM for the fast PI build agent (https://cloud.cerebras.ai)
CEREBRAS_API_KEY=
# TaskFuel REST API key (create one at https://app.taskfuel.ai/keys). Only the server uses it,
# through the dedicated tools in worker/tools.ts.
TASKFUEL_API_KEY=

# LLM for the slow PI build agent
OPENROUTER_API_KEY=

# --- Optional (defaults shown) ---
# PI_PROVIDER=cerebras
# PI_MODEL=qwen-3.8-27b
# PI_THINKING=high

# PORT=8080
# DATA_DIR=./data
# MAX_BUILDS=2
# BUILD_TIMEOUT_MIN=15
# Pause the queue when the TaskFuel balance (USD) drops below this
# MIN_TASKFUEL_BALANCE=1
# SUBMITS_PER_IP_PER_HOUR=10
# TASKFUEL_BASE_URL=https://app.taskfuel.ai
# Set to 0 to build without TaskFuel (free test runs)
# TASKFUEL_ENABLED=1
# Max paid runtime tool calls (tweet searches) per hour across all widgets; cached hits are free
# TOOL_CALLS_PER_HOUR=120

# --- M1.5 (Jev triage) ---
# TYPESAFE_API_KEY=

# --- M2 (Fly) ---
# Only used locally by flyctl to deploy (not set as app secrets)
FLY_APP_NAME=
FLY_DEPLOY_TOKEN=
# ADMIN_TOKEN=
# TEAM_PASSCODE=
